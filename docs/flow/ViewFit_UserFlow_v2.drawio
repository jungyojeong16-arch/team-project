<mxfile host="app.diagrams.net"><diagram name="ViewFit 사용자 흐름도" id="viewfit-flow-v2"><mxGraphModel><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="ViewFit 사용자 흐름도 (화면 ERD)" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="420" height="40" as="geometry"/></mxCell><mxCell id="u" value="&lt;b&gt;사용자&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=13;" vertex="1" parent="1"><mxGeometry x="440" y="40" width="160" height="50" as="geometry"/></mxCell><mxCell id="d1" value="가입 · 로그인" style="rhombus;whiteSpace=wrap;html=1;fillColor=#E3F4EA;strokeColor=#2E7D4F;fontSize=12;" vertex="1" parent="1"><mxGeometry x="440" y="130" width="160" height="80" as="geometry"/></mxCell><mxCell id="s1" value="&lt;b&gt;회원가입 / 로그인 화면&lt;/b&gt;&lt;br&gt;이메일 · 비밀번호 · 약관 동의" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E3F4EA;strokeColor=#2E7D4F;fontSize=13;" vertex="1" parent="1"><mxGeometry x="390" y="250" width="260" height="60" as="geometry"/></mxCell><mxCell id="d2" value="설문 응답" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="440" y="350" width="160" height="80" as="geometry"/></mxCell><mxCell id="s2" value="&lt;b&gt;설문 화면&lt;/b&gt;&lt;br&gt;STEP1 생활 정보 → STEP2 장르 취향&lt;br&gt;→ STEP3 시청 이력" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=13;" vertex="1" parent="1"><mxGeometry x="370" y="470" width="300" height="70" as="geometry"/></mxCell><mxCell id="p1" value="&lt;b&gt;사용자 성향 파악&lt;/b&gt;&lt;br&gt;연령대 · 직업 · 선호/비선호 장르 · 시청 이력" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E8F7;strokeColor=#8E3B86;fontSize=13;" vertex="1" parent="1"><mxGeometry x="370" y="590" width="300" height="60" as="geometry"/></mxCell><mxCell id="d3" value="AI 분석&lt;br&gt;(+ TPO)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#F3E8F7;strokeColor=#8E3B86;fontSize=12;" vertex="1" parent="1"><mxGeometry x="440" y="690" width="160" height="80" as="geometry"/></mxCell><mxCell id="s3" value="&lt;b&gt;메인 화면&lt;/b&gt;&lt;br&gt;TPO 인사말&lt;br&gt;&lt;b&gt;AI 추천 목록&lt;/b&gt;&lt;br&gt;OTT 통합 랭킹&lt;br&gt;세대별 교차 평점" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=13;" vertex="1" parent="1"><mxGeometry x="390" y="810" width="260" height="110" as="geometry"/></mxCell><mxCell id="d4" value="작품 선택" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="440" y="960" width="160" height="80" as="geometry"/></mxCell><mxCell id="s4" value="&lt;b&gt;작품 상세 화면&lt;/b&gt;&lt;br&gt;줄거리 · 평점 · 볼 수 있는 OTT" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E3F4EA;strokeColor=#2E7D4F;fontSize=13;" vertex="1" parent="1"><mxGeometry x="390" y="1080" width="260" height="60" as="geometry"/></mxCell><mxCell id="d5" value="OTT로 이동&lt;br&gt;(딥링크)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#E3F4EA;strokeColor=#2E7D4F;fontSize=12;" vertex="1" parent="1"><mxGeometry x="440" y="1180" width="160" height="80" as="geometry"/></mxCell><mxCell id="x1" value="&lt;b&gt;OTT 앱 (외부)&lt;/b&gt;&lt;br&gt;넷플릭스 · 티빙 · 디즈니+ 등에서 시청" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=13;" vertex="1" parent="1"><mxGeometry x="390" y="1300" width="260" height="60" as="geometry"/></mxCell><mxCell id="d6" value="평가" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="440" y="1400" width="160" height="80" as="geometry"/></mxCell><mxCell id="s5" value="&lt;b&gt;평점 및 코멘트&lt;/b&gt;&lt;br&gt;0.5~5점 · 한 줄 코멘트" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=13;" vertex="1" parent="1"><mxGeometry x="390" y="1520" width="260" height="60" as="geometry"/></mxCell><mxCell id="d7" value="검색" style="rhombus;whiteSpace=wrap;html=1;fillColor=#E3F4EA;strokeColor=#2E7D4F;fontSize=12;" vertex="1" parent="1"><mxGeometry x="900" y="960" width="140" height="80" as="geometry"/></mxCell><mxCell id="d8" value="조회" style="rhombus;whiteSpace=wrap;html=1;fillColor=#E3F4EA;strokeColor=#2E7D4F;fontSize=12;" vertex="1" parent="1"><mxGeometry x="900" y="130" width="140" height="80" as="geometry"/></mxCell><mxCell id="s6" value="&lt;b&gt;내 프로필 화면&lt;/b&gt;&lt;br&gt;내 정보 · 취향 다시 설정&lt;br&gt;최근 평점 · 시청 이력" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E3F4EA;strokeColor=#2E7D4F;fontSize=13;" vertex="1" parent="1"><mxGeometry x="850" y="250" width="240" height="70" as="geometry"/></mxCell><mxCell id="n1" value="TPO의 장소·상황을 입력받는 화면은 아직 없음 → 팀 결정 필요&lt;br&gt;(시간은 접속 시각으로 자동 판단)" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFF4CC;strokeColor=#B58A00;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="760" y="690" width="260" height="60" as="geometry"/></mxCell><mxCell id="lg" value="&lt;b&gt;표기법&lt;/b&gt;&lt;br&gt;□ 흰 사각형 = 팀 원안의 화면&lt;br&gt;□ 초록 = 이번에 추가한 화면·행동&lt;br&gt;◇ 마름모 = 사용자 행동&lt;br&gt;▢ 보라 = 시스템 처리 (AI)&lt;br&gt;┄ 점선 사각형 = 외부 서비스&lt;br&gt;┄▶ 점선 화살표 = 분기 · 되돌아오는 흐름&lt;br&gt;1 / N = 관계 (한 번 / 여러 번)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#BBBBBB;fontSize=11;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="90" width="250" height="150" as="geometry"/></mxCell><mxCell id="e0" value="1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="u" target="d1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1" value="1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="d1" target="s1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="s1" target="d2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="d2" target="s2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="s2" target="p1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p1" target="d3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="d3" target="s3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" value="1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="s3" target="d4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e8" value="N" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="d4" target="s4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e9" value="1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="s4" target="d5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e10" value="N" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="d5" target="x1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e11" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="x1" target="d6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e12" value="N" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="d6" target="s5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e13" value="설문 건너뛰기 → 기본 추천(랭킹)" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;dashed=1;strokeColor=#8E3B86;fontColor=#8E3B86;" edge="1" parent="1" source="s2" target="s3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e14" value="성향 데이터 갱신 → 다음 추천에 반영" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;dashed=1;strokeColor=#8E3B86;fontColor=#8E3B86;" edge="1" parent="1" source="s5" target="p1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e15" value="세대별 평점에 반영" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;dashed=1;strokeColor=#8E3B86;fontColor=#8E3B86;" edge="1" parent="1" source="s5" target="s3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e16" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="s3" target="d7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e17" value="N" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="d7" target="s4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e18" value="1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="u" target="d8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e19" value="1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="d8" target="s6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e20" value="취향 다시 설정" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;dashed=1;strokeColor=#8E3B86;fontColor=#8E3B86;" edge="1" parent="1" source="s6" target="s2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e21" value="" style="edgeStyle=none;html=1;endArrow=none;dashed=1;strokeColor=#B58A00;" edge="1" parent="1" source="n1" target="d3"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>

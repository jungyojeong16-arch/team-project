pse;html=1;whiteSpace=wrap;fontSize=11;fillColor=#FFFFFF;strokeColor=#777777;" vertex="1" parent="1"><mxGeometry x="1252" y="1040" width="128" height="34" as="geometry"/></mxCell><mxCell id="tpo_a-11" value="장소" style="ellipse;html=1;whiteSpace=wrap;fontSize=11;fillColor=#FFFFFF;strokeColor=#777777;" vertex="1" parent="1"><mxGeometry x="1252" y="1084" width="128" height="34" as="geometry"/></mxCell><mxCell id="tpo_a10" value="상황" style="ellipse;html=1;whiteSpace=wrap;fontSize=11;fillColor=#FFFFFF;strokeColor=#777777;" vertex="1" parent="1"><mxGeometry x="1660" y="1062" width="128" height="34" as="geometry"/></mxCell><mxCell id="d_search" value="검색" style="rhombus;html=1;whiteSpace=wrap;fontSize=12;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="1055" y="1396" width="150" height="76" as="geometry"/></mxCell><mxCell id="d_revisit" value="재방문 로그인" style="rhombus;html=1;whiteSpace=wrap;fontSize=12;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="-75" y="464" width="150" height="76" as="geometry"/></mxCell><mxCell id="feedback" value="추천 피드백" style="rounded=0;html=1;whiteSpace=wrap;fontSize=14;fontStyle=1;fillColor=#FFFFFF;strokeColor=#333333;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="-100" y="841" width="200" height="56" as="geometry"/></mxCell><mxCell id="feedback_a-10" value="만족도 (3단계)" style="ellipse;html=1;whiteSpace=wrap;fontSize=11;fillColor=#FFFFFF;strokeColor=#777777;" vertex="1" parent="1"><mxGeometry x="-268" y="830" width="128" height="34" as="geometry"/></mxCell><mxCell id="feedback_a-11" value="시청 여부" style="ellipse;html=1;whiteSpace=wrap;fontSize=11;fillColor=#FFFFFF;strokeColor=#777777;" vertex="1" parent="1"><mxGeometry x="-268" y="874" width="128" height="34" as="geometry"/></mxCell><mxCell id="feedback_a10" value="코멘트" style="ellipse;html=1;whiteSpace=wrap;fontSize=11;fillColor=#FFFFFF;strokeColor=#777777;" vertex="1" parent="1"><mxGeometry x="140" y="852" width="128" height="34" as="geometry"/></mxCell><mxCell id="note" value="TPO의 장소·상황을 입력받는 화면은 아직 없음 → 팀 결정 필요&lt;br&gt;(시간은 접속 시각으로 자동 판단)" style="shape=note;html=1;whiteSpace=wrap;size=14;fillColor=#FFF4CC;strokeColor=#B58A00;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="840" y="990" width="250" height="56" as="geometry"/></mxCell><mxCell id="title" value="ViewFit 사용자 흐름도 (ERD 형식)" style="text;html=1;fontSize=22;fontStyle=1;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="-320" y="20" width="520" height="40" as="geometry"/></mxCell><mxCell id="legend" value="&lt;b&gt;표기법&lt;/b&gt;&lt;br&gt;□ 사각형 = 데이터 (화면에서 다루는 대상)&lt;br&gt;○ 타원 = 그 데이터에 필요한 항목&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;u&gt;밑줄&lt;/u&gt; = 기본키 (하나를 구분하는 값)&lt;br&gt;◇ 마름모 = 사용자의 행동 (관계)&lt;br&gt;1 / N = 한 번 / 여러 번&lt;br&gt;▢ 보라 = 시스템(AI) 처리 · ┄ 점선 = 외부 서비스&lt;br&gt;┄▶ 보라 점선 = 되돌아오는 흐름" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FAFAFA;strokeColor=#BBBBBB;fontSize=12;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="-320" y="70" width="330" height="190" as="geometry"/></mxCell><mxCell id="e_user_a-10" value="" style="endArrow=none;html=1;strokeColor=#9A9A9A;" edge="1" parent="1" source="user" target="user_a-10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_user_a-11" value="" style="endArrow=none;html=1;strokeColor=#9A9A9A;" edge="1" parent="1" source="user" target="user_a-11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_user_a-12" value="" style="endArrow=none;html=1;strokeColor=#9A9A9A;" edge="1" parent="1" source="user" target="user_a-12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_user_a10" value="" style="endArrow=none;html=1;strokeColor=#9A9A9A;" edge="1" parent="1" source="user" target="user_a10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_user_a11" value="" style="endArrow=none;html=1;strokeColor=#9A9A9A;" edge="1" parent="1" source="user" target="user_a11"><mxGeo
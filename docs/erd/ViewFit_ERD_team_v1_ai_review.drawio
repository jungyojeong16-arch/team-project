<mxfile host="app.diagrams.net"><diagram name="팀 원본 AI 검토 수정본" id="viewfit-team-review"><mxGraphModel dx="1600" dy="1200" grid="0" page="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="user" value="&lt;div style='font-size:17px'&gt;&lt;b&gt;user (회원)&lt;/b&gt;&lt;/div&gt;&lt;div style='font-size:11px;color:#2E7D32'&gt;원본 user + survey 합침&lt;/div&gt;&lt;div style='font-size:15px'&gt;&lt;div&gt;&lt;font color='#3399FF'&gt;- user_id&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color='#000000'&gt;- email&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color='#000000'&gt;- password&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color='#000000'&gt;- nickname&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color='#000000'&gt;- age_group&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color='#000000'&gt;- job&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color='#000000'&gt;- created_at&lt;/font&gt;&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="0" y="300" width="270" height="235" as="geometry"/></mxCell><mxCell id="rating" value="&lt;div style='font-size:17px'&gt;&lt;b&gt;rating (평점)&lt;/b&gt;&lt;/div&gt;&lt;div style='font-size:11px;color:#2E7D32'&gt;원본 lately_rating + age_rating&lt;/div&gt;&lt;div style='font-size:15px'&gt;&lt;div&gt;&lt;font color='#3399FF'&gt;- rating_id&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color='#FF3333'&gt;- user_id&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color='#FF3333'&gt;- content_id&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color='#000000'&gt;- score&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color='#000000'&gt;- comment&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color='#000000'&gt;- age_group_at_rating&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color='#000000'&gt;- rated_at&lt;/font&gt;&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="420" y="-40" width="270" height="235" as="geometry"/></mxCell><mxCell id="like" value="&lt;div style='font-size:17px'&gt;&lt;b&gt;like (좋아요)&lt;/b&gt;&lt;/div&gt;&lt;div style='font-size:11px;color:#2E7D32'&gt;원본 like_contents&lt;/div&gt;&lt;div style='font-size:15px'&gt;&lt;div&gt;&lt;font color='#3399FF'&gt;- like_id&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color='#FF3333'&gt;- user_id&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color='#FF3333'&gt;- content_id&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color='#000000'&gt;- liked_at&lt;/font&gt;&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="420" y="250" width="270" height="160" as="geometry"/></mxCell><mxCell id="watch" value="&lt;div style='font-size:17px'&gt;&lt;b&gt;watch_history (시청 이력)&lt;/b&gt;&lt;/div&gt;&lt;div style='font-size:11px;color:#2E7D32'&gt;원본 profile.watch_history&lt;/div&gt;&lt;div style='font-size:15px'&gt;&lt;div&gt;&lt;font color='#3399FF'&gt;- watch_id&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color='#FF3333'&gt;- user_id&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color='#FF3333'&gt;- content_id&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color='#000000'&gt;- watched_at&lt;/font&gt;&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="420" y="450" width="270" height="160" as="geometry"/></mxCell><mxCell id="rec" value="&lt;div style='font-size:17px'&gt;&lt;b&gt;recommendation (AI 추천)&lt;/b&gt;&lt;/div&gt;&lt;div style='font-size:11px;color:#2E7D32'&gt;원본 user(tpo).tpo_ranking, ai_search&lt;/div&gt;&lt;div style='font-size:15px'&gt;&lt;div&gt;&lt;font color='#3399FF'&gt;- rec_id&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color='#FF3333'&gt;- user_id&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color='#FF3333'&gt;- content_id&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color='#000000'&gt;- rank&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color='#000000'&gt;- feedback&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color='#000000'&gt;- recommended_at&lt;/font&gt;&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="420" y="650" width="270" height="210" as="geometry"/></mxCell><mxCell id="genre" value="&lt;div style='font-size:17px'&gt;&lt;b&gt;genre (장르)&lt;/b&gt;&lt;/div&gt;&lt;div style='font-size:11px;color:#2E7D32'&gt;신규: survey의 선호 장르를 분리&lt;/div&gt;&lt;div style='font-size:15px'&gt;&lt;div&gt;&lt;font color='#3399FF'&gt;- genre_id&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color='#000000'&gt;- name&lt;/font&gt;&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="420" y="1010" width="270" height="110" as="geometry"/></mxCell><mxCell id="content" value="&lt;div style='font-size:17px'&gt;&lt;b&gt;content (작품)&lt;/b&gt;&lt;/div&gt;&lt;div style='font-size:11px;color:#2E7D32'&gt;원본 content (비어 있던 속성 채움)&lt;/div&gt;&lt;div style='font-size:15px'&gt;&lt;div&gt;&lt;font color='#3399FF'&gt;- content_id&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color='#000000'&gt;- title&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color='#000000'&gt;- type&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color='#000000'&gt;- overview&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color='#000000'&gt;- poster_url&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color='#000000'&gt;- release_year&lt;/font&gt;&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="840" y="300" width="270" height="210" as="geometry"/></mxCell><mxCell id="ranking" value="&lt;div style='font-size:17px'&gt;&lt;b&gt;ranking (통합 랭킹)&lt;/b&gt;&lt;/div&gt;&lt;div style='font-size:11px;color:#2E7D32'&gt;원본 total ranking&lt;/div&gt;&lt;div style='font-size:15px'&gt;&lt;div&gt;&lt;font color='#3399FF'&gt;- ranking_id&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color='#FF3333'&gt;- content_id&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color='#000000'&gt;- rank&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color='#000000'&gt;- ranked_at&lt;/font&gt;&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="840" y="800" width="270" height="160" as="geometry"/></mxCell><mxCell id="ott" value="&lt;div style='font-size:17px'&gt;&lt;b&gt;ott (OTT 플랫폼)&lt;/b&gt;&lt;/div&gt;&lt;div style='font-size:11px;color:#2E7D32'&gt;신규: 딥링크 이동용&lt;/div&gt;&lt;div style='font-size:15px'&gt;&lt;div&gt;&lt;font color='#3399FF'&gt;- ott_id&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color='#000000'&gt;- name&lt;/font&gt;&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1290" y="60" width="270" height="110" as="geometry"/></mxCell><mxCell id="tpo" value="&lt;div style='font-size:17px'&gt;&lt;b&gt;tpo (상황)&lt;/b&gt;&lt;/div&gt;&lt;div style='font-size:11px;color:#2E7D32'&gt;원본 user(tpo)에서 분리&lt;/div&gt;&lt;div style='font-size:15px'&gt;&lt;div&gt;&lt;font color='#3399FF'&gt;- tpo_id&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color='#000000'&gt;- name&lt;/font&gt;&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1290" y="560" width="270" height="110" as="geometry"/></mxCell><mxCell id="r0" value="1:N" style="edgeStyle=none;html=1;endArrow=none;fontSize=13;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="user" target="rating"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="r1" value="1:N" style="edgeStyle=none;html=1;endArrow=none;fontSize=13;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="content" target="rating"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="r2" value="1:N" style="edgeStyle=none;html=1;endArrow=none;fontSize=13;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="user" target="like"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="r3" value="1:N" style="edgeStyle=none;html=1;endArrow=none;fontSize=13;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="content" target="like"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="r4" value="1:N" style="edgeStyle=none;html=1;endArrow=none;fontSize=13;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="user" target="watch"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="r5" value="1:N" style="edgeStyle=none;html=1;endArrow=none;fontSize=13;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="content" target="watch"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="r6" value="1:N" style="edgeStyle=none;html=1;endArrow=none;fontSize=13;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="user" target="rec"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="r7" value="1:N" style="edgeStyle=none;html=1;endArrow=none;fontSize=13;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="content" target="rec"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="r8" value="N:M (선호/비선호)" style="edgeStyle=none;html=1;endArrow=none;fontSize=13;fontStyle=1;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0;entryY=0.5;" edge="1" parent="1" source="user" target="genre"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="135" y="1065"/></Array></mxGeometry></mxCell><mxCell id="r9" value="N:M" style="edgeStyle=none;html=1;endArrow=none;fontSize=13;fontStyle=1;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.9;entryX=1;entryY=0.5;" edge="1" parent="1" source="content" target="genre"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="780" y="489"/><mxPoint x="780" y="1065"/></Array></mxGeometry></mxCell><mxCell id="r10" value="N:M (딥링크)" style="edgeStyle=none;html=1;endArrow=none;fontSize=13;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="content" target="ott"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="r11" value="N:M" style="edgeStyle=none;html=1;endArrow=none;fontSize=13;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="content" target="tpo"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="r12" value="1:N" style="edgeStyle=none;html=1;endArrow=none;fontSize=13;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="content" target="ranking"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="legend" value="&lt;font style='font-size:20px' color='#FF3333'&gt;외래키&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:20px' color='#3399FF'&gt;기본키&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:12px' color='#2E7D32'&gt;초록 글씨 = 원본의 어느 테이블에서 왔는지&lt;/font&gt;" style="whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="1290" y="860" width="270" height="90" as="geometry"/></mxCell><mxCell id="note" value="&lt;b&gt;AI 검토로 바뀐 점&lt;/b&gt;&lt;br&gt;① main, profile 삭제: 화면(페이지)이지 저장할 데이터가 아님&lt;br&gt;② survey → user에 합침 (age_group, job)&lt;br&gt;③ 선호/비선호 장르 → genre 테이블과 N:M 관계로 분리&lt;br&gt;④ 같은 이름 user 테이블 2개 → tpo, recommendation으로 분리&lt;br&gt;⑤ age_rating 삭제: 세대별 평점은 rating에서 계산&lt;br&gt;⑥ like: profile_id·content(글자) → user_id·content_id(FK)&lt;br&gt;⑦ storage(보관함) 삭제: 프로필에서 구현하기로 결정&lt;br&gt;⑧ 비어 있던 content 속성 채움, ott 추가 (딥링크)&lt;br&gt;⑨ 색이 뒤바뀐 PK/FK 수정, 선에 1:N · N:M 표시" style="text;html=1;align=left;verticalAlign=top;fontSize=13;strokeColor=#2E7D32;fillColor=#F1F8E9;spacing=10;" vertex="1" parent="1"><mxGeometry x="1290" y="980" width="420" height="230" as="geometry"/></mxCell><mxCell id="title" value="ViewFit ERD — 팀 원본을 AI가 검토해 수정한 버전" style="text;html=1;fontSize=24;fontStyle=1;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="0" y="-140" width="700" height="40" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>

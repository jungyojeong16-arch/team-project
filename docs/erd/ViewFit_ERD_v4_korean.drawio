<mxfile host="app.diagrams.net"><diagram name="ViewFit ERD v4.1 한글" id="viewfit-erd-v41-ko"><mxGraphModel dx="1600" dy="1200" grid="1" gridSize="10" page="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="ViewFit ERD v4.1 (한글 · 논리 모델)" style="text;html=1;fontSize=22;fontStyle=1;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="420" height="36" as="geometry"/></mxCell><mxCell id="legend" value="&lt;b&gt;표기법&lt;/b&gt;&lt;br&gt;&lt;font color='#A3238F'&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/font&gt; 기본키 · &lt;font color='#2F5FA8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; 외래키 · &lt;font color='#6A6479'&gt;&lt;b&gt;UK&lt;/b&gt;&lt;/font&gt; 중복 불가 · 컬럼? = 비어 있어도 됨&lt;br&gt;선 끝 ‖ = 1, 까마귀발 = N, ○ = 없을 수도 있음&lt;br&gt;초록 머리 = ERD v3 대비 Figma 분석으로 추가된 테이블&lt;br&gt;설문 테이블은 회원 테이블에 합침" style="text;html=1;align=left;verticalAlign=top;fontSize=12;strokeColor=#C9C2D6;fillColor=#FAF9FC;spacing=10;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="360" height="110" as="geometry"/></mxCell><mxCell id="t_user" value="회원  (user)" style="swimlane;fontStyle=1;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;html=1;fillColor=#F3E8F7;strokeColor=#7A6A8F;fontSize=14;swimlaneFillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="40" y="380" width="340" height="342" as="geometry"/></mxCell><mxCell id="t_user_0" value="&lt;font color='#A3238F'&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/font&gt;&amp;nbsp;&amp;nbsp;&lt;b&gt;회원번호&lt;/b&gt; &lt;font color='#8A849A'&gt;BIGINT&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=8;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=12;" vertex="1" parent="t_user"><mxGeometry y="30" width="340" height="26" as="geometry"/></mxCell><mxCell id="t_user_1" value="&lt;font color='#6A6479'&gt;&lt;b&gt;UK&lt;/b&gt;&lt;/font&gt;&amp;nbsp;&amp;nbsp
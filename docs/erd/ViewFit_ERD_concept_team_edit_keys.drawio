      <mxCell id="rank_pk" parent="1" style="ellipse;html=1;whiteSpace=wrap;fontSize=12;fillColor=#FFFFFF;strokeColor=#3399FF;fontColor=#3399FF;strokeWidth=1.5;fontStyle=4;" value="랭킹 번호 (PK)" vertex="1"><mxGeometry x="800" y="1312" width="108" height="34" as="geometry" /></mxCell><mxCell id="e_rank_pk" parent="1" edge="1" source="rank" target="rank_pk" value="" style="endArrow=none;html=1;strokeColor=#777777;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="rank_fk" parent="1" style="ellipse;html=1;whiteSpace=wrap;fontSize=12;fillColor=#FFFFFF;strokeColor=#FF3333;fontColor=#FF3333;strokeWidth=1.5;" value="작품 번호 (FK)" vertex="1"><mxGeometry x="1052" y="1312" width="108" height="34" as="geometry" /></mxCell><mxCell id="e_rank_fk" parent="1" edge="1" source="rank" target="rank_fk" value="" style="endArrow=none;html=1;strokeColor=#777777;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="keys_note" parent="1" vertex="1" value="&lt;b&gt;N:M 관계의 키 (나중에 연결 테이블이 될 때)&lt;/b&gt;&lt;br&gt;관계마다 양쪽 엔터티의 기본키를 &lt;font color='#FF3333'&gt;외래키&lt;/font&gt;로 가져오고,&lt;br&gt;둘을 합쳐 &lt;u&gt;복합 기본키&lt;/u&gt;로 씀&lt;br&gt;· 평가한다 · 좋아요 · 시청한다 · ai에게 추천 받는다&lt;br&gt;&amp;nbsp;&amp;nbsp;→ &lt;font color='#FF3333'&gt;아이디(FK)&lt;/font&gt; + &lt;font color='#FF3333'&gt;작품 번호(FK)&lt;/font&gt;&lt;br&gt;· 선호한다 → &lt;font color='#FF3333'&gt;아이디(FK)&lt;/font&gt; + &lt;font color='#FF3333'&gt;장르 번호(FK)&lt;/font&gt;&lt;br&gt;· 속한다 → &lt;font color='#FF3333'&gt;작품 번호(FK)&lt;/font&gt; + &lt;font color='#FF3333'&gt;장르 번호(FK)&lt;/font&gt;&lt;br&gt;· 제공된다 → &lt;font color='#FF3333'&gt;작품 번호(FK)&lt;/font&gt; + &lt;font color='#FF3333'&gt;플랫폼 번호(FK)&lt;/font&gt;&lt;br&gt;· TPO 추천 → &lt;font color='#FF3333'&gt;작품 번호(FK)&lt;/font&gt; + &lt;font color='#FF3333'&gt;TPO 번호(FK)&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=12;strokeColor=#BBBBBB;fillColor=#FAFAFA;spacing=10;"><mxGeometry x="1475" y="1315" width="360" height="185" as="geometry" /></mxCell></root>

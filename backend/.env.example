# 이 파일을 복사해서 같은 폴더에 ".env" 로 저장한 뒤 값을 바꾸세요.
# .env 에는 비밀번호가 들어가므로 GitHub 에 올라가지 않습니다 (.gitignore 에 등록됨).

# Django 비밀 키 (개발용은 아무 문자열이나 OK, 배포할 때는 꼭 새로 만들기)
DJANGO_SECRET_KEY=change-me-dev-only
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# MariaDB 접속 정보 (README 의 "MariaDB 준비" 에서 만든 값)
# DB_NAME 을 비워 두면 MariaDB 대신 SQLite 파일(db.sqlite3)로 임시 실행됩니다.
DB_NAME=viewfit
DB_USER=viewfit
DB_PASSWORD=viewfit1234
DB_HOST=127.0.0.1
DB_PORT=3306

# 프론트엔드(Next.js) 주소 - 이 주소에서 오는 API 요청을 허용
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
